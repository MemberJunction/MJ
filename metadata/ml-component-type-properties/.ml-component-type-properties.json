[
  {
    "fields": {
      "ComponentTypeID": "@lookup:MJ: ML Component Types.Name=Model",
      "PropertyKey": "StatisticalGate",
      "Operation": "Add",
      "Value": "{\"Kind\": \"max-single-feature-share\", \"Threshold\": 0.6}",
      "Sequence": 0,
      "ItemKey": "single-feature-dominance",
      "Rationale": "Every model kind — glass-box or trained — is invalid if one feature already contains the answer; dominance is leakage until a human signs off."
