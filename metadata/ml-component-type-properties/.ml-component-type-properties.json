  {
    "fields": {
      "ComponentTypeID": "@lookup:MJ: ML Component Types.Name=Structure",
      "PropertyKey": "GuidanceRationale",
      "Operation": "Add",
      "Value": "{\"note\": \"A structure inherits its explanation from what fills it. A bagged glass-box rubric is still explainable; a stack over three black boxes is not, however good its score. Choose the structure for what it lets you say, not only for what it scores.\"}",
      "Sequence": 0,
      "ItemKey": "explainability-cost",
      "Rationale": "True of every structure: composing multiplies capability and divides interpretability, and that trade is the decision being made when a structure is chosen at all."
    },
    "primaryKey": {
      "ID": "6FA15D1B-5B02-4151-BD3F-9C50ACD8E0B2"
    },
    "sync": {
      "lastModified": "2026-09-04T03:37:32.694Z",
      "checksum": "58a3ac4c9e9c451ac44a11a33c9a6bcf6da0d2e84eb2a5b817f635005421d557"
    }
  },
  {
    "fields": {
      "ComponentTypeID": "@lookup:MJ: ML Component Types.Name=Sequence",
      "PropertyKey": "Explainability",
      "Operation": "Add",
      "Value": "\"state-sequence\"",
      "Sequence": 0,
      "ItemKey": null,
      "Rationale": "A sequence family explains a record as a path through hidden states over time, not as a weighted sum of columns. It is a genuinely different kind of explanation and a reader should be told which one they are getting."
    },
    "primaryKey": {
      "ID": "CED351E6-8A04-46A7-98DD-3AC054C7056E"
    },
    "sync": {
