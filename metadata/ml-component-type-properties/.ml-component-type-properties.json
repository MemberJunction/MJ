      "checksum": "d0b9aa4bb9bf659bf57baaa90f94dd368012454be00ea467dadb15054bcbc28f"
    }
  },
  {
    "fields": {
      "ComponentTypeID": "@lookup:MJ: ML Component Types.Name=Encoding",
      "PropertyKey": "GuidanceRationale",
      "Operation": "Add",
      "Value": "{\"note\": \"An encoder's vocabulary is learned from the training rows alone. Fitting it on everything lets a category that only appears in the holdout influence the encoding, which flatters the final score.\"}",
      "Sequence": 0,
      "ItemKey": "fit-on-train-only",
      "Rationale": "True of every encoder below: the leakage risk is in the fit, not in the transform."
    },
    "primaryKey": {
      "ID": "43BDFD93-121B-4750-AD40-5B82196CF65D"
    },
    "sync": {
