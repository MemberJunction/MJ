    }
  },
  {
    "fields": {
      "ComponentTypeID": "@lookup:MJ: ML Component Types.Name=Structure",
      "PropertyKey": "GuidanceRationale",
      "Operation": "Add",
      "ItemKey": "when-composing-earns-it",
      "Value": "{\"note\": \"Compose when the filled components have NON-OVERLAPPING capability \\u2014 when each sees something the others genuinely cannot. Measured on this platform: a tree ensemble already spans both smooth trends and threshold interactions, so stacking a linear model onto one adds a view it never needed. On a target built from a smooth trend plus a pure XOR, holdout AUC was 0.534 linear, 0.883 forest, 0.8835 stacked \\u2014 the families diverged as far as they can and the stack still tied the better one. Overlapping families cost explainability and buy nothing. What DOES earn a structure: a component that already learned a sub-problem and can be frozen into a slot, families reading genuinely different shapes of data, or variance reduction over a single high-variance estimator.\", \"evidence\": \"packages/AI/PredictiveStudio/Sidecar/src/python/tests/test_composition_earns_it.py\"}",
      "Sequence": 1,
      "Rationale": "True of every structure: a structure's value comes from what its fillers see DIFFERENTLY, so the test for reaching for one is capability overlap rather than expected accuracy. Placed on the Structure root because it holds for bagging and stacking alike."
    },
    "primaryKey": {
      "ID": "C6009C71-EDB2-4A15-AE1A-961FF45F4DE6"
    },
    "sync": {
      "lastModified": "2026-09-05T21:59:44.049Z",
      "checksum": "a65abbf72fbd47eaafe528f3033efd26df5abb38d9463aa9108afcc00c198efb"
    }
  }
