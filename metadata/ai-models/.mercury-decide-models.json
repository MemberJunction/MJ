    "fields": {
      "Name": "Mercury Decide",
      "Description": "Inception Labs' diffusion-based decision model, mercury-decide, released on September 30, 2026. It answers Likelihood, Choice (up to 255 options) and Score (up to 10 levels) questions about one state, each with a probability for every option or level, and writes no text; it takes the same System One request as Jev. MJ reaches it directly through Inception's Decisions API (POST https://api.inceptionlabs.ai/v1/decisions, with the same Inception API key as Mercury 2) through the InceptionDecision driver, or through OpenRouter's Decisions API as inception/mercury-decide (pinned to the dated inception/mercury-decide-20260930, served by Inception with a 65,536-token context, text only) through the OpenRouterDecision driver. Inception charges $0.02 per million input tokens, a promotional price 50% off its regular $0.04; output is free. OpenRouter says it leads JevBench; MJ has not measured it. Its raw probabilities are not calibrated to MJ's data, so set thresholds on calibrated values.",
      "AIModelTypeID": "@lookup:MJ: AI Model Types.Name=Decision",
      "PowerRank": 44,
      "IsActive": true,
      "SpeedRank": 0,
      "CostRank": 0,
      "InheritTypeModalities": true,
      "ModelConfiguration": {
