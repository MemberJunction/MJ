[
  {
    "fields": {
      "Name": "hubspot",
      "ClassName": "HubspotConnector",
      "BatchMaxRequestCount": 100,
      "BatchRequestWaitTime": 10,
      "Configuration": {
        "AuthFlow": "api-key",
        "AuthFlowNote": "HubSpot private apps use a static access token sent as a Bearer token in the Authorization header. Public (marketplace) apps use OAuth 2.0 authorization code flow. The primary connector flow is private app (Bearer token); OAuth2 flow is also documented in the spec. No token refresh — private app tokens do not expire.",
        "AuthHeaderPattern": "Authorization: Bearer <token>",
        "OAuthEndpoints": {
          "authorizationUrl": "https://app.hubspot.com/oauth/authorize",
          "tokenUrl": "https://api.hubapi.com/oauth/v1/token"
        },
        "TokenRefreshStrategy": "oauth2-authcode-refresh-token",
        "TokenRefreshStrategyNote": "Private app tokens do not expire and have no refresh. OAuth 2.0 public apps receive an access_token + refresh_token; use the standard refresh_token grant at the tokenUrl to rotate before expiry. AccessTokenResponse schema requires: access_token, expires_in, refresh_token, token_type, token_use.",
        "universalPK": {
          "fieldName": "id",
          "alternateFieldName": "hs_object_id",
          "note": "All CRM standard objects expose the system PK as both \"id\" on the top-level SimplePublicObject wrapper AND as \"hs_object_id\" in the properties bag. The connector uses \"id\" as the primary PK field name. Non-CRM objects (HubDB, Files, Sequences, etc.) also use \"id\" as their primary key field."
        },
        "PaginationDefaults": {
          "type": "Cursor",
          "cursorParam": "after",
          "cursorResponsePath": "paging.next.after",
          "defaultPageSize": 100,
          "maxPageSizeList": 100,
          "maxPageSizeSearch": 200,
          "note": "List endpoints use GET with \"after\" query param (cursor token). Search endpoints use POST with \"after\" in request body. The response includes paging.next.after when more results exist. When paging.next is absent/null the set is exhausted."
        },
        "APIVersioningStrategy": "url-path",
        "APIVersioningNote": "HubSpot uses date-versioned API paths (e.g., /crm/objects/2026-03/{objectType}) and legacy stable paths (v3, v4). The 2026-03 LATEST version is the current standard for CRM objects. Some APIs still use v3/v4 stable. Version is embedded in the URL path segment.",
        "IncrementalSyncCapability": {
          "supported": true,
          "mechanism": "search-api-filter",
          "watermarkField": "hs_lastmodifieddate",
          "alternateWatermarkField": "lastmodifieddate",
          "filterOperator": "GTE",
          "searchWindowCap": 10000,
          "searchWindowCapNote": "The CRM Search API is limited to 10,000 total results per query. When an incremental window (from watermark to now) contains more than 10,000 modified records, the connector must re-anchor using a (hs_lastmodifieddate, hs_object_id) keyset cursor to page completely past the 10k boundary. Attempting to page beyond 10,000 results in a 400 error.",
          "searchRateLimit": "5 requests per second per account (separate, lower limit from the main burst limit)",
          "searchRateLimitSource": "https://developers.hubspot.com/docs/api-reference/latest/crm/search-the-crm (Explicit statement: \"The search endpoints are rate limited to five requests per second per account.\")",
          "nonCRMIncrementalNote": "Non-CRM objects (CMS blog posts/pages, marketing emails) use updatedAfter timestamp query params instead of the search API. Consult per-IO IncrementalWatermarkField for the specific param."
        },
        "WebhooksAvailable": true,
        "WebhooksNote": "HubSpot webhooks deliver CRM events (create, delete, merge, propertyChange, associationChange) for contacts, companies, deals, tickets, and other objects. Subscriptions are configured per-app via /webhooks/v3/{appId}/subscriptions. Webhook payloads are signed with X-HubSpot-Signature (SHA-256 HMAC of app secret + request body). The webhooks journal API (/webhooks-journal/) provides replay capability.",
        "WebhooksSignatureAlgorithm": "HMAC-SHA256",
        "WebhooksSignatureHeader": "X-HubSpot-Signature-v3",
        "BulkOperationsAvailable": true,
        "BulkOperationsNote": "CRM batch endpoints exist at /crm/objects/2026-03/{objectType}/batch/* for batch read (up to 100 records), batch create, batch update, batch archive, and batch upsert. These are the primary mechanism for efficient sync writes. The Imports API (/crm/v3/imports) handles large-scale CSV bulk imports as async jobs.",
        "BulkOperationsBasePath": "/crm/objects/2026-03/{objectType}/batch",
        "ErrorResponseShape": {
          "httpStatusCodes": {
            "400": "Bad request (validation error, query >3000 chars, search window exceeded)",
            "401": "Authentication credentials not found / invalid",
            "403": "Insufficient scopes",
            "404": "Resource not found",
            "429": "Rate limit exceeded — check X-HubSpot-RateLimit-Remaining header",
            "5xx": "Server error"
          },
          "body": {
            "status": "string — always \"error\" for error responses",
            "message": "string — human-readable description and remediation steps",
            "correlationId": "UUID string — include in support tickets",
            "category": "string — error category (e.g. INVALID_AUTHENTICATION, VALIDATION_ERROR, RATE_LIMIT)",
            "subCategory": "string | null — more specific category",
            "errors": "ErrorDetail[] | null — further detail on validation errors",
            "context": "object | null — key-value map of error context (e.g. invalidPropertyName, missingScopes)",
            "links": "object | null — link map to remediation docs"
          },
          "rateLimitHeaders": {
            "X-HubSpot-RateLimit-Max": "max requests in current window",
            "X-HubSpot-RateLimit-Remaining": "requests remaining in window",
            "X-HubSpot-RateLimit-Interval-Milliseconds": "window size in ms (e.g. 10000 = 10 seconds)",
            "X-HubSpot-RateLimit-Daily-Remaining": "daily requests remaining (not included in OAuth responses)",
            "Retry-After": "seconds to wait on 429"
          }
        },
        "CustomObjectMarkerPattern": {
          "fullyQualifiedNameFormat": "p_<portalId>_<objectName>",
          "objectTypeIdPrefix": "2-",
          "note": "Custom CRM objects have a fullyQualifiedName = p_<portalId>_<objectName>. In API paths, custom objects are referenced by their objectTypeId (numeric, prefixed with \"2-\", e.g. \"2-12345\"). Standard objects use named slugs (contacts, companies, deals). Custom objects are discovered at runtime via GET /crm-object-schemas/2026-03/schemas."
        },
        "CustomFieldMarkerPattern": {
          "marker": "hubspotDefined",
          "customValue": false,
          "builtInValue": true,
          "description": "Properties with hubspotDefined=false are customer-created custom properties. Properties with hubspotDefined=true are HubSpot default properties. All properties are accessible via GET /crm/properties/2026-03/{objectType}."
        },
        "WriteCapability": {
          "supported": true,
          "create": "Yes — all standard CRM objects support POST /crm/objects/2026-03/{objectType}",
          "update": "Yes — PATCH /crm/objects/2026-03/{objectType}/{objectId} for property updates",
          "delete": "Yes — DELETE /crm/objects/2026-03/{objectType}/{objectId} archives (soft-delete) the object",
          "upsert": "Yes — batch upsert via /crm/objects/2026-03/{objectType}/batch/upsert (by unique property)",
          "batchCreate": "Yes — POST /crm/objects/2026-03/{objectType}/batch/create (up to 100 records)",
          "batchUpdate": "Yes — POST /crm/objects/2026-03/{objectType}/batch/update (up to 100 records)"
        },
        "ConcurrencyControl": "none",
        "ConcurrencyControlNote": "HubSpot CRM does not expose ETag, If-Match, If-Unmodified-Since, or version fields on standard object endpoints. Conflict resolution must use snapshot-3-way only. The HubSpot platform handles last-write-wins internally.",
        "DeleteSemantics": "soft",
        "DeleteSemanticsDetail": {
          "crmObjects": "soft — DELETE /crm/objects/2026-03/{objectType}/{objectId} archives the record. Archived records are excluded from list/search results by default. Use ?archived=true to retrieve archived records. Objects can be permanently deleted via batch GDPR delete endpoint (GET /crm/v3/objects/contacts/gdpr-delete) for GDPR compliance.",
          "hardDeleteNote": "GDPR-compliant permanent deletion is available via POST /crm/v3/objects/{objectType}/gdpr-delete. This permanently removes the record. Regular DELETE is archive only."
        },
        "DefaultSyncDirection": "Pull",
        "DefaultConflictResolution": "DestWins",
        "DefaultConflictResolutionReason": "No ETag or version field in the API. ConcurrencyControl=none prevents reliable MostRecent resolution. DestWins is the safe default — when bidirectional is enabled, the downstream MJ system reflects the HubSpot source of truth on pull.",
        "RateLimitPolicy": {
          "tokensPerSec": 10,
          "burst": 100,
          "dailyLimitPerAccount": 250000,
          "burstWindowSeconds": 10,
          "searchApiTokensPerSec": 5,
          "note": "Main API: 100 requests per 10 seconds (Free/Starter private apps). Professional: 190/10s, 625k/day. Enterprise: 190/10s, 1M/day. Search API is separately limited to 5 requests per second per account. Daily limits are per-account shared across all apps. RetryAfter header is returned on 429. Rate limit headers: X-HubSpot-RateLimit-Max, X-HubSpot-RateLimit-Remaining, X-HubSpot-RateLimit-Interval-Milliseconds."
        },
        "AssociationGraphNote": "HubSpot CRM uses a first-class association graph between standard objects (contacts-companies, contacts-deals, deals-tickets, etc.). Associations are pairwise typed records (HUBSPOT_DEFINED standard types + USER_DEFINED portal-specific labels) accessed via POST /crm/associations/2026-03/{fromObjectType}/{toObjectType}/batch/read. Association type IDs must be resolved at runtime via GET /crm/associations/{from}/{to}/labels — they cannot be declared statically per-portal.",
        "DiscoveryIsAuthoritative": false,
        "DiscoveryIsAuthoritativeRationale": "HubSpot has no single endpoint that returns the complete set of objects (types + custom objects) a portal has enabled. The object-library API (/crm/v3/object-library/object-type-enablements) lists enabled standard objects, but custom objects require a separate call to /crm-object-schemas/2026-03/schemas. Neither call alone constitutes a complete authoritative enumeration. Absence in any single discovery call proves nothing — a missing object may exist under a separate discovery path. Therefore DiscoveryIsAuthoritative=false: the deactivation path (Status=Disabled on absent objects) is gated off."
      },
      "CredentialTypeID": "@lookup:MJ: Credential Types.Name=HubSpot API"
    },
