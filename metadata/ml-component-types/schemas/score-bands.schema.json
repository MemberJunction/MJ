{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Score Bands",
  "type": "object",
  "properties": {
    "Bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "Label": { "type": "string" },
          "MinScore": { "type": "number" },
          "MaxScore": { "type": "number" },
          "Severity": { "type": "string" },
          "ColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "required": ["Label", "MinScore", "MaxScore"],
        "additionalProperties": false
      },
      "description": "Half-open [Min,Max) tiers that must tile the score scale contiguously; the top band is inclusive."
    },
    "DeadbandDelta": { "type": "number", "minimum": 0, "description": "Minimum score movement before a band transition is reported." }
  },
  "required": ["Bands"],
  "additionalProperties": false
}
