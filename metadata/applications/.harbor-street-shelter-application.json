  "fields": {
    "Name": "Harbor Street Animal Shelter",
    "Description": "Intake, housing, care and adoption for the Harbor Street shelter. The teaching application for MJ Academy course 1.",
    "Icon": "fa-solid fa-paw",
    "Color": "#264FAF",
    "Status": "Active",
    "NavigationStyle": "App Switcher",
    "DefaultForNewUser": true,
    "DefaultSequence": 60,
    "DefaultNavItems": [
      {
        "Label": "Dashboard",
        "Description": "The shelter at a glance. Every tile is a filtered count -- MaxRows 1 plus TotalRowCount -- so the page is cheap enough to open on every visit. Capacity and vaccination compliance cannot be had that way and are handled explicitly; see the component.",
        "Icon": "fa-solid fa-gauge-high",
        "ResourceType": "Custom",
        "DriverClass": "ShelterDashboard",
        "isDefault": true,
        "Status": "Active"
      },
      {
        "Label": "Animals",
        "Description": "Every animal in the shelter. A dynamic view -- Explorer's generic entity grid, addressed by entity name, with no saved view record behind it.",
        "Icon": "fa-solid fa-paw",
        "ResourceType": "Custom",
        "DriverClass": "ShelterAnimalsGrid",
        "isDefault": false,
        "Status": "Active"
      },
      {
        "Label": "Housing",
        "Description": "Housing units and their capacity. Records you can open and edit.",
        "Icon": "fa-solid fa-house-chimney",
        "ResourceType": "Custom",
        "DriverClass": "ShelterHousingGrid",
        "isDefault": false,
        "Status": "Active"
      },
      {
        "Label": "Breeds",
        "Description": "Reference data: the breeds the shelter recognises.",
        "Icon": "fa-solid fa-dog",
        "ResourceType": "Custom",
        "DriverClass": "ShelterBreedsGrid",
        "isDefault": false,
        "Status": "Active"
      },
      {
        "Label": "Care Log",
        "Description": "Every care entry across all animals. The same generic entity grid the other pages use -- ResourceType 'Custom' plus its OWN DriverClass, because sharing a class makes the shell highlight every item using it.",
        "Icon": "fa-solid fa-notes-medical",
        "ResourceType": "Custom",
        "DriverClass": "ShelterCareLogsGrid",
        "isDefault": false,
        "Status": "Active"
      },
      {
        "Label": "Occupancy",
        "Description": "How full each unit is, computed live. These rows are not records -- this is RunQuery.",
        "Icon": "fa-solid fa-chart-simple",
        "ResourceType": "Queries",
        "RecordID": "@lookup:MJ: Queries.Name=Housing Occupancy",
        "isDefault": false,
        "Status": "Active"
      }
    ]
  },
