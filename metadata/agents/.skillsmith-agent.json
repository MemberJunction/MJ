[
  {
    "_comments": [
      "SkillSmith — top-level skill-authoring meta-agent (the *Smith family, alongside ActionSmith).",
      "Pure metadata, no DriverClass: composes existing catalog members into MJ: AI Skills records",
      "via the generic CRUD actions. CreatedByUserID is defaulted server-side by",
      "MJAISkillEntityServer, so the agent never has to know the acting user's ID.",
      "Persists new skills as Status=Pending by default; a human activates after review."
    ],
    "fields": {
      "Name": "SkillSmith",
      "CategoryID": "@lookup:MJ: AI Agent Categories.Name=Platform Management",
      "Description": "Meta-agent that authors AI Skills for the skill catalog. Interviews the user about the capability, discovers bundle members with Find Candidate Actions/Agents, checks for overlapping existing skills, drafts agent-agnostic instructions with confirm-before-acting guardrails, gates on user approval, and persists the skill with its action and sub-agent junctions (default Status=Pending for human review).",
      "TypeID": "@lookup:MJ: AI Agent Types.Name=Loop",
      "Status": "Active",
      "ModelSelectionMode": "Agent",
      "ExposeAsAction": true,
      "InvocationMode": "Any",
      "IconClass": "fa-solid fa-hat-wizard",
      "PayloadSelfWritePaths": "[\"name\", \"description\", \"category\", \"iconClass\", \"color\", \"instructions\", \"bundledActions\", \"bundledSubAgents\", \"existingSkillCheck\", \"skillId\", \"status\", \"message\"]",
      "FinalPayloadValidation": "{\"skillId\": \"any\", \"status\": \"string:!empty\", \"message\": \"string:!empty\"}",
      "FinalPayloadValidationMode": "Warn",
      "MaxIterationsPerRun": 15
    },
