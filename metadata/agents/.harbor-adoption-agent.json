    "fields": {
      "Name": "Harbor Shelter Adoption Matcher",
      "Description": "Visitor-facing kiosk assistant for Harbor Street Animal Shelter. A visitor uses it on an iPad in the lobby: they describe their home, the agent finds Available animals that fit and explains why in plain language. When they want to keep one, it activates the 'Save My Matches' skill, which sets up their Adopter record and writes MJ: Adoptions rows at status Inquiry — the interest list AND the first step of the adoption funnel.",
      "TypeID": "@lookup:MJ: AI Agent Types.Name=Loop",
      "Status": "Active",
      "IconClass": "fa-solid fa-heart",
      "ExecutionOrder": 0,
      "ModelSelectionMode": "Agent",
      "ExposeAsAction": false,
      "DefaultArtifactTypeID": "@lookup:MJ: Artifact Types.Name=Data",
      "ArtifactCreationMode": "Always",
      "PayloadSelfWritePaths": [
        "source",
        "title",
        "columns.*",
        "rows.*",
        "metadata.*",
        "tables.*"
      ],
      "MaxIterationsPerRun": 12,
      "MaxCostPerRun": 1,
      "MaxTimePerRun": 180000,
      "AcceptsSkills": "Limited",
      "SkillActivationMode": "Auto"
    },
