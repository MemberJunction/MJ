            "AgentID": "@parent:ID",
            "Name": "Review against brand rules",
            "Description": "A bounded While loop. Its body reviews AND revises in ONE iteration, because a task graph is acyclic and check-then-revise-then-check-again is not drawable. The loop runs again only to re-check the revision, and gives up after three attempts rather than spending forever on a draft that is not converging.",
            "StartingStep": 0,
            "StepType": "While",
            "LoopBodyType": "Prompt",
            "PromptID": "@lookup:MJ: AI Prompts.Name=Workflow Demo: Brand Review",
            "Configuration": {
              "type": "While",
              "condition": "payload.brandOK !== true",
              "maxIterations": 3,
              "continueOnError": false
            },
