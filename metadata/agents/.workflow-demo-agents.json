  {
    "fields": {
      "Name": "Content Pipeline",
      "CategoryID": "@lookup:MJ: AI Agent Categories.Name=Demo",
      "Description": "Researches a topic from two angles, drafts a short piece, and revises it against brand rules until it passes or gives up. A workflow demo of the two graph shapes a linear flow cannot express: a bounded While loop, and an exclusive pair where exactly one branch runs. The two research steps run in SEQUENCE, not in parallel — a Flow agent compiles with sequential traversal, where a step with two outgoing paths becomes an exclusive choice, so a fan-out would have meant 'either' and silently skipped one of them.",
      "TypeID": "@lookup:MJ: AI Agent Types.Name=Flow",
      "Status": "Active",
      "ExecutionOrder": 0,
      "ExposeAsAction": false,
      "IconClass": "fa-solid fa-pen-nib"
    },
    "relatedEntities": {
      "MJ: AI Agent Prompts": [],
      "MJ: AI Agent Steps": [
        {
          "fields": {
            "AgentID": "@parent:ID",
            "Name": "Research: broad",
            "Description": "The first research angle. Feeds the focused search, which then feeds the draft — a CHAIN, not a parallel pair. A Flow agent compiles with TraversalMode 'sequential' (flow-graph-executor.ts), where any step with two outgoing paths becomes an exclusive choice: exactly one of them runs. So a fan-out from here could not express 'both', it expressed 'either', and the branch that lost was Skipped in silence. The draft still sees both results because each step's output accumulates into the payload.",
            "StartingStep": 1,
            "StepType": "Action",
            "ActionID": "@lookup:MJ: Actions.Name=Google Custom Search",
            "ActionInputMapping": {
              "Query": "what is a directed acyclic graph used for in workflow automation"
            },
            "ActionOutputMapping": {
              "Items": "broadResearch"
            },
            "Status": "Active",
            "PositionX": 80,
            "PositionY": 40,
            "Width": 200,
            "Height": 80
          },
          "relatedEntities": {
            "MJ: AI Agent Step Paths": [
              {
                "fields": {
                  "OriginStepID": "@parent:ID",
                  "DestinationStepID": "@lookup:MJ: AI Agent Steps.Name=Research: focused&AgentID=@parent:AgentID",
                  "Condition": null,
                  "Priority": 100,
                  "Description": "The ONLY path out of this step, deliberately. A second one would make this a fan-out, which sequential traversal compiles into an exclusive choice — and the loser is Skipped without comment."
                },
                "primaryKey": {
                  "ID": "F3F2BAF1-4A77-490D-922D-8E5F4BDEC8D8"
                },
                "sync": {
                  "lastModified": "2026-08-10T22:48:26.338Z",
                  "checksum": "8f73677c4ef75fe2f9ca22f3e62c2e184e2093cdd90340316fcc4175cc334ed3"
                }
              }
            ]
          },
          "primaryKey": {
            "ID": "1E9F8F35-9523-4739-B01C-2025246703D9"
          },
          "sync": {
            "lastModified": "2026-08-10T23:37:37.702Z",
            "checksum": "2838739d342d2672824ed77aa4e8e757d54a8321d2f1677a0975f6223c89ac93"
          }
        },
        {
          "fields": {
            "AgentID": "@parent:ID",
            "Name": "Research: focused",
            "Description": "The second research angle, reached from the broad search. NOT a second starting step: a workflow has exactly one entry, and a step marked as a second one is pruned as unreachable — which is how this demo spent its early life drafting from half the evidence. Its mapping names Google Custom Search's OWN parameters (Query in, Items out). It previously used Web Search's names (SearchTerms/SearchResults) against this action, so the output mapping matched nothing, the step reported Complete, and its results were discarded silently — a step that ran, cost money, and contributed nothing.",
            "StartingStep": 0,
            "StepType": "Action",
            "ActionID": "@lookup:MJ: Actions.Name=Google Custom Search",
            "ActionInputMapping": {
              "Query": "task graph dispatcher durable execution retry semantics"
            },
            "ActionOutputMapping": {
              "Items": "focusedResearch"
            },
            "Status": "Active",
            "PositionX": 80,
            "PositionY": 180,
            "Width": 200,
            "Height": 80
          },
          "relatedEntities": {
            "MJ: AI Agent Step Paths": [
              {
                "fields": {
                  "OriginStepID": "@parent:ID",
                  "DestinationStepID": "@lookup:MJ: AI Agent Steps.Name=Draft the piece&AgentID=@parent:AgentID",
                  "Condition": null,
                  "Priority": 100,
                  "Description": "The other half of the AND-join. The draft waits for BOTH."
                },
                "primaryKey": {
                  "ID": "30BF8477-8297-4C35-A6EE-33FC0C5E05CD"
