                }
              },
              {
                "fields": {
                  "AgentID": "@parent:ID",
                  "Name": "REUSABLE_COMPONENTS",
                  "Description": "Trained components from earlier models that are approved for reuse — each with the story describing what it learned. This is what makes ReuseInstanceID usable: a component here can be dropped into a slot as a FROZEN child, carrying its fitted state, so a new model inherits a proven relationship instead of re-learning it. Only components whose fitted artifact can actually be loaded appear here — offering one that cannot be frozen would fail at train time, after the Architect had already built a decision around it. Never invent an ID; a ReuseInstanceID not on this list will fail when its artifact cannot be loaded.",
                  "SourceType": "RunView",
                  "EntityName": "MJ: ML Components",
                  "ExtraFilter": "PromotionState = 'Approved' AND IsTrained = 1 AND ArtifactFileID IS NOT NULL",
