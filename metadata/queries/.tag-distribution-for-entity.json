    "fields": {
      "Name": "Tag Distribution For Entity",
      "CategoryID": "@lookup:MJ: Query Categories.Name=Tags",
      "UserQuestion": "What tags are most common on records of a given entity?",
      "Description": "Aggregates tag counts across all records of a given entity, showing how many records have each tag along with average relevance weight and date range. Composable — use as a subquery or join to analyze topic distribution, category breakdowns, and tag popularity.",
      "SQL": "@file:SQL/tag-distribution-for-entity.sql",
      "TechnicalDescription": "Groups vwTaggedItems by tag for a given entity name, joining to vwTags for display names and parent hierarchy. Returns COUNT, AVG(Weight), MIN/MAX tagged dates per tag. Only includes Active tags. No ORDER BY for composability — callers should add their own sorting (e.g., ORDER BY RecordCount DESC). Parameters: entityName (entity display name e.g. \"Member Engagement Logs\").",
      "Status": "Approved",
      "QualityRank": 8,
      "ExecutionCostRank": 2,
      "Reusable": true,
      "UsesTemplate": true
    },
