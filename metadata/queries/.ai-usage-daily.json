[
  {
    "fields": {
      "Name": "AIUsageDaily",
      "CategoryID": "@lookup:MJ: Query Categories.Name=AI",
      "UserQuestion": "What is our daily AI usage and cost broken down by model, agent, user, and scope?",
      "Description": "Primary daily aggregation of AI usage facts. Computes model-call counts, token volumes, latencies (P50/P95), cache reads, and spend (by currency) across all dimensional attributes.",
      "SQL": "@file:SQL/ai-usage-daily.sql",
      "TechnicalDescription": "Live analytical query over [__mj].vwAIUsageFacts, one row per UTC day x dimension set x CostCurrency. Optional start/end ({{ start | sqlDate }}, {{ end | sqlDate }}) select whole days: every day that overlaps [start, end) is returned complete, by rounding start down and end up to UTC midnight and range-filtering the base RunAt column (sargable on IX_AIPromptRun_RunAt). The day is derived from RunAt by truncation and exposed as DayBucket (DATE) plus BucketStartUTC / BucketEndUTC. Parallel parents are counted in ParallelParents and excluded from every other measure. Latency percentiles are PERCENTILE_CONT window functions collapsed with MAX (SQL Server 2019+).",
      "Status": "Approved",
      "QualityRank": 9,
      "ExecutionCostRank": 3,
      "UsesTemplate": true,
      "IsMaterialized": false
    },
