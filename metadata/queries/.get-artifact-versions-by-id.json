[
  {
    "fields": {
      "Name": "GetArtifactVersionsByID",
      "CategoryID": "@lookup:MJ: Query Categories.Name=Agents",
      "UserQuestion": "What are the full artifact version records for a given set of artifact version IDs?",
      "Description": "Returns artifact version fields (name, content mode, file ref, content, mime) joined with the parent artifact and artifact type (including ToolLibraryClass) for a supplied list of ArtifactVersionIDs.",
      "SQL": "@file:SQL/get-artifact-versions-by-id.sql",
      "TechnicalDescription": "Single-query replacement for AgentRunner.gatherConversationArtifacts per-junction loop that issued two Load() calls per row (MJ: Artifact Versions + MJ: Artifacts). Joins vwArtifactVersions → vwArtifacts → vwArtifactTypes so ToolLibraryClass is available without a third lookup. Accepts a JS array via {{ versionIds | sqlIn }}.",
      "Status": "Approved",
      "QualityRank": 9,
      "ExecutionCostRank": 2,
      "UsesTemplate": true
    },
