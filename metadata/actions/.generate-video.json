[
  {
    "fields": {
      "Name": "Generate Video",
      "Description": "Generates a single raw AI video clip using AI video generation models (such as Black Forest Labs FLUX 3) via AIVideoRunner, with no multi-shot composition, captions, narration, or audio mixing. For composed multi-shot films with titles, lower thirds, captions, narration, and music, use Video Studio. Supports TextToVideo, ImageToVideo, Continuation, and VideoToVideo modes with reference images, keyframes, and source video loaded from MJ Storage as the caller.",
      "DriverClass": "Generate Video",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-film",
      "CategoryID": "@lookup:MJ: Action Categories.Name=AI"
    },
