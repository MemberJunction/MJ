[
  {
    "fields": {
      "Name": "Render Architecture Diagram",
      "Description": "Renders an interactive workflow, lifecycle, sequence, or dataflow diagram from an MJ Diagram Spec JSON object via @memberjunction/ai-diagrams. Validates the spec and computes deterministic layout + self-contained SVG implementing the MJ Diagram Data Contract (data-mj-diagram=\"1\") for interactive rendering in <mj-markdown> and <mj-svg-artifact-viewer>. On validation failure, returns VALIDATION_FAILED with structured diagnostics (JSON path, message, closest ID suggestions, and fix instructions) so you can repair the spec and retry. Call Get Architecture Diagram Reference first to read the spec schema for the desired DiagramType.",
      "DriverClass": "__RenderArchitectureDiagram",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-sitemap",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data"
    },
    "primaryKey": {
      "ID": "42FC2391-612C-4336-9D80-C53948EDBA6D"
    },
    "relatedEntities": {
