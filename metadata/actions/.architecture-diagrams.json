        {
          "fields": {
            "ActionID": "@parent:ID",
            "Name": "DiagramType",
            "Type": "Input",
            "ValueType": "Scalar",
            "IsArray": false,
            "Description": "Diagram kind to render: workflow (actor swimlanes, tasks, decisions, exception paths), lifecycle (state groups, status transitions, step badges), sequence (participants, chronological messages, phase bands), or dataflow (left-to-right processing stages and data-labeled flows). Optional if SpecJSON includes a top-level kind field; when both are given they must match.",
            "IsRequired": false
          },
          "primaryKey": {
            "ID": "5A9D9D99-544B-473E-A6BA-E6E780B8A99C"
          },
