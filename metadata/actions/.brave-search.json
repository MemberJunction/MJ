  {
    "fields": {
      "Name": "Brave Search",
      "Description": "Web search through the Brave Search API. Returns ranked title/url/snippet results from Brave's own independent index rather than reselling Google's or Bing's, so it does not share a failure mode with the Google Custom Search action (discontinued 2027-01-01) or with SERP-proxy vendors.",
      "DriverClass": "Brave Search",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-brands fa-brave",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Web"
    },
