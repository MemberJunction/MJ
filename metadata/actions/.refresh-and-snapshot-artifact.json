    "fields": {
      "Name": "Refresh and Snapshot Artifact",
      "Description": "Refreshes an artifact's live blocks (LiveTables, =MJ.QUERY, =MJ.VIEW, =MJ.IMPORTRANGE, :::mj-block) under the triggering user's permissions, saves a new version when changes are detected, computes a diff summary, and optionally posts a summary card to a Conversation.",
      "DriverClass": "__RefreshAndSnapshotArtifact",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-rotate",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Utilities"
    },
