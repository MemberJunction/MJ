[
  {
    "fields": {
      "Name": "Get Graph Context",
      "Description": "Returns a bounded neighborhood of a semantic graph (default \"MJ Canon\") around concepts matching a natural-language Question and/or explicit seed nodes: the nodes and edges as JSON and as compact prompt text. Every node is one the caller may see. Use it to find the canonical definition of a business term and the views, queries and entities that define, measure or describe it. Fails with GRAPH_NOT_FOUND when the graph is unknown or not active.",
      "DriverClass": "Get Graph Context",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-diagram-project",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data"
    },
