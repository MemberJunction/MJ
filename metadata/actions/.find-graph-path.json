[
  {
    "fields": {
      "Name": "Find Graph Path",
      "Description": "Finds how two things are connected in a semantic graph (default \"MJ Canon\"): the fewest-hop path between From and To that the caller may see, as JSON and as prompt text. From and To are each a concept (its name, a synonym or its ID) or a record ({ EntityName, RecordID }). Use it to explain how a business term relates to an entity, a query or another term. Returns NO_PATH when they are not connected within the limits, and AMBIGUOUS_ENDPOINT with the candidate concepts when a name fits several equally well, so you can ask which one is meant.",
      "DriverClass": "Find Graph Path",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-route",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data"
    },
