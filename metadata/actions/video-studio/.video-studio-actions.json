[
  {
    "_comments": [
      "Produce Video — runs a complete Video Studio multi-agent production in Autonomous mode and creates a standalone Video Production artifact.",
      "Type='Custom' + DriverClass='Produce Video' binds to @RegisterClass(BaseAction, 'Produce Video')."
    ],
    "fields": {
      "Name": "Produce Video",
      "Description": "Runs a full multi-stage Video Studio production (Director, Art Director, Storyboard, Pre-Production data snapshot and narration, Motion Engineer HTML/CSS/JS composition, deterministic HyperFrames render, and Critic review) and persists a standalone Video Production artifact plus MP4 and poster files in MJ: Files. Unlike Generate Video (which calls a generative video vendor to create a single raw video clip without composition, narration, or data bindings), Produce Video orchestrates an entire composed, brand-governed, data-bound video deliverable.",
      "Type": "Custom",
      "DriverClass": "Produce Video",
      "Status": "Active",
      "IconClass": "fa-solid fa-clapperboard",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Video Studio?create&Description=Actions for MemberJunction Video Studio — full multi-agent video productions and deliverables."
    },
