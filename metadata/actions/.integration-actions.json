            "ID": "B1692872-FC37-498B-BBEF-76393B09B6C5"
          }
        },
        {
          "fields": {
            "ActionID": "@parent:ID",
            "Name": "StorageCredentialID",
            "Type": "Input",
            "ValueType": "Scalar",
            "IsArray": false,
            "Description": "ID of the MJ: Credentials record whose SasToken (or Secret/Key) value holds the container SAS token; the SQL Server credential is always created from the resolved token. Either this or SasToken is required for Azure Blob sources",
