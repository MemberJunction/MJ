    "fields": {
      "Name": "Bootstrap SQL Server Integration From Backup",
      "Description": "Bootstraps a large SQL Server integration by restoring an Azure Blob backup (or local disk backup) into a temporary staging database, executing high-speed local ETL into target MemberJunction tables, seeding watermarks to BackupStartDate, and tearing down staging.",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data&Parent=System",
      "DriverClass": "Bootstrap SQL Server Integration From Backup",
      "Type": "Custom",
      "CodeApprovalStatus": "Approved",
      "Status": "Active",
      "IconClass": "fa-solid fa-database"
    },
