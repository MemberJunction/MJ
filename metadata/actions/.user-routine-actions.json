[
  {
    "fields": {
      "Name": "Run User Routine Now",
      "Description": "Runs one MJ: User Routines row immediately, on the user's request, without changing its schedule. Unlike setting NextRunAt to now, which makes the dispatcher claim the routine and spends a one-shot, this hands the routine to the dispatcher's manual-run path: the claim and the wake gate are skipped, a one-shot keeps its scheduled time and a recurring routine keeps its cadence. The caller must own the routine unless they are an Owner-type user. The run completes in the background; its result lands on the run row, the routine's conversation and its notification.",
      "DriverClass": "Run User Routine Now",
      "Type": "Custom",
      "CategoryID": "@lookup:MJ: Action Categories.Name=System",
      "CodeApprovalStatus": "Approved",
      "Status": "Active",
      "IconClass": "fa-solid fa-bolt"
    },
