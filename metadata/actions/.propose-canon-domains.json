[
  {
    "fields": {
      "Name": "Propose Canon Domains",
      "Description": "Groups entities into candidate business domains by community detection over their foreign-key and IS-A links (deterministic, no AI call) and proposes each as a Domain concept in a semantic graph (default \"MJ Canon\"). With DryRun (the default) it only returns the proposals. With DryRun = false it writes each as a Proposed Domain concept plus Inferred, Proposed Describes edges from its member entities, for a person to rename, approve or reject. A domain name already in the graph is never proposed again.",
      "DriverClass": "Propose Canon Domains",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-object-group",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data"
    },
