[
  {
    "fields": {
      "Name": "Run Decision",
      "Description": "Answers typed questions about a state with a decision model, in one fast call: a Likelihood (the probability a statement is true), a Choice (one option from a described set) or a Score (a position on a rubric), each with probabilities. Use it for routing, gating and classification steps in agents and flows. It writes no text. Branch on a Choice or Score Value; treat probabilities as information until thresholds are calibrated.",
      "DriverClass": "Run Decision",
      "Type": "Custom",
      "Status": "Active"
    },
