  {
    "fields": {
      "Name": "Modify Form Contribution",
      "Description": "Refines an existing form contribution. Pending source + in-place (default) overwrites the draft; Active source (default minor) or any explicit patch/minor/major bump inserts a new Pending Component + row and leaves the source alone (a Pending source being bumped is demoted to Inactive). Refreshes the row's slot/key/claims/title from the spec's formContribution block; an optional Precedence replaces the row's precedence. Acts only on the caller's own User-scope rows: a Role or Global row, or another user's row, returns FORBIDDEN, because shared panels are managed from the form's Manage drawer or Form Builder. Any new row is User scope. Returns INVALID_CLAIM, before writing anything, when the spec's claim breaks a rule the database enforces; the Component and row writes run in one transaction.",
      "DriverClass": "__ModifyFormContribution",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-pen-to-square",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Utilities"
    },
