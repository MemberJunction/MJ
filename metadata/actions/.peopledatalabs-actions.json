[
  {
    "_comments": [
      "PEOPLE DATA LABS - ENRICH PEOPLE. A thin action for agents and workflows over PDLPersonClient.BulkEnrich in",
      "@memberjunction/actions-peopledatalabs: resolves a key (CompanyID credential, else PDL_API_KEY), sends up to",
      "100 people, returns the normalized matches (education, employment, LinkedIn URL, PDL id, likelihood) and writes",
      "nothing. Emails, phones and addresses PDL returns are never mapped. Code-to-code callers use the client, not this",
      "action. DriverClass is the @RegisterClass(BaseAction, 'PDLEnrichPeopleAction') key.",
      "No sync block: the release push writes that back. primaryKey from uuidgen."
    ],
    "fields": {
      "Name": "People Data Labs - Enrich People",
      "Description": "Looks up to 100 people up in People Data Labs and returns their education and employment history, LinkedIn URL, PDL id and match likelihood. Billed one PDL credit per matched person; misses are free. Writes nothing.",
      "DriverClass": "PDLEnrichPeopleAction",
      "Type": "Custom",
      "Status": "Active",
      "IconClass": "fa-solid fa-id-card",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Data Enrichment"
    },
