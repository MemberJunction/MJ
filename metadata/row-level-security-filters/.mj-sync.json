    "filter": "Name = 'Model Predictions View Gate' OR Name LIKE 'UI: Agent Channel%' OR Name LIKE 'UI: Agent Suggestions%'",
    "externalizeFields": [],
    "ignoreNullFields": true,
    "ignoreVirtualFields": true,
    "lookupFields": {},
    "relatedEntities": {}
  }
}
