[
  {
    "fields": {
      "Name": "Integration Tests — Deterministic",
      "Description": "Every registered integration check bundle, one Test each. Sequenced so all server-transport bundles run BEFORE any client-transport bundle: a client bundle rebinds the process-global provider, and a server bundle that runs after one bootstraps against a Network provider and fails (issue #3251). Bundles needing a live model carry their own tier and skip-pass when RUN_AGENT_TESTS is unset, so this suite is safe to run unconditionally.",
      "Status": "Active"
    },
