{
  "name": "@memberjunction/ai-realtime-client",
  "type": "module",
  "version": "6.2.0-edge.1",
  "description": "MemberJunction: Framework-agnostic browser client abstraction for provider-direct realtime (voice) sessions - BaseRealtimeClient + provider drivers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "media": [
        "dist/media/index.d.ts"
      ]
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "dependencies": {
    "@memberjunction/global": "6.2.0-edge.1",
    "@memberjunction/ai": "6.2.0-edge.1",
    "@google/genai": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "24.10.11",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  }
}
