+// MJ shim: loadDiagram's checks on an in-memory spec. No input file, no output path, and no
+// repository evidence (a server has no checkout to verify source claims against).
+function loadInMemoryDiagram(diagramType, job) {
+  const diagram = job.diagram;
+  validateSchema(diagramType, diagram);
+  applyLocaleTranslations(diagramType, diagram);
+  validateCrossCollectionContracts(diagramType, diagram);
+  validateEngineeringProfile(diagramType, diagram);
+  return { diagram, template: job.template, outPath: '', sourceEvidence: null };
+}
