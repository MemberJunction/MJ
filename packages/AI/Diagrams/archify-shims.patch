+// MJ shim: a server must not fetch whatever URL a spec names, so in memory only catalog marks resolve.
+function rejectRemoteBrandMarks(diagramType, diagram) {
+  const collection = SEMANTIC_COLLECTIONS[diagramType];
+  const nodes = Array.isArray(diagram[collection]) ? diagram[collection] : [];
+  const remote = nodes.flatMap((node, index) => {
+    const brand = node?.brand;
+    const isRemote = (typeof brand === 'object' && brand !== null) || (typeof brand === 'string' && /^https?:/i.test(brand.trim()));
+    return isRemote ? [`/${collection}/${index}/brand`] : [];
+  });
+  if (!remote.length) return;
+  const message = `Brand marks from URLs are not available here: ${remote.join(', ')}`;
+  throwDiagnosticError(message, [{
+    code: 'brand/remote-unavailable', message,
+    subject: { paths: remote },
+    supportedFixes: ['use a brand name from the built-in catalog', 'remove the brand field'],
+  }]);
+}
