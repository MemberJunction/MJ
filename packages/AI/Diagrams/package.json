{
  "name": "@memberjunction/ai-diagrams",
  "type": "module",
  "version": "6.2.0-edge.6",
  "description": "MemberJunction: spec schema, validator, server-side SVG renderer, and interactive viewer for workflow, lifecycle, sequence, and data-flow diagrams",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "default": "./dist/viewer.js"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "ts-node-dev src/index.ts",
    "build": "tsc && tsc-alias -f",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@memberjunction/global": "6.2.0-edge.6"
  },
  "devDependencies": {
    "@types/node": "24.10.11",
    "jsdom": "^26.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  }
}
