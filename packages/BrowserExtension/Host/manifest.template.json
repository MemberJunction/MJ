{
  "manifest_version": 3,
  "name": "__MJ_BRAND_NAME__",
  "short_name": "__MJ_SHORT_NAME__",
  "version": "__MJ_VERSION__",
  "description": "__MJ_DESCRIPTION__",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "tabs"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open __MJ_SHORT_NAME__"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.memberjunction.com/*",
      "http://localhost:*/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
