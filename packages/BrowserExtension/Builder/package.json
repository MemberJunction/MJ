{
  "name": "@memberjunction/browser-extension-builder",
  "version": "6.2.0",
  "description": "White-label Chrome Extension brand-stamping CLI (mj-ext-build) and programmatic builder for MemberJunction Browser Extensions (MJ Co-Pilot, Betty, Sidecar, and custom tenant brands).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mj-ext-build": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:e2e": "vitest run src/__tests__/playwright-live-websites.e2e.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@memberjunction/browser-extension-core": "6.2.0",
    "@memberjunction/browser-extension-host": "6.2.0",
    "@memberjunction/theme-engine": "6.2.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.51.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ.git"
  },
  "license": "MIT",
  "author": "MemberJunction.com"
}
