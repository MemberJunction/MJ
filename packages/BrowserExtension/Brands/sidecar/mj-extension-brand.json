{
  "BrandSlug": "sidecar",
  "BrandName": "Sidecar — Continuous Learning Companion",
  "ShortName": "Sidecar",
  "Version": "6.2.0",
  "Description": "Interactive workflow coach and continuous learning companion with live DOM spotlighting and guided step-by-step playbooks.",
  "AssistantDisplayName": "Sidecar",
  "Tagline": "Continuous Learning & Workflow Companion",
  "DefaultControlBackend": "auto",
  "IncludeDebuggerPermission": true,
  "HostPermissions": [
    "<all_urls>"
  ],
  "ExternallyConnectableMatches": [
    "https://*.memberjunction.com/*",
    "http://localhost:*/*"
  ],
  "BlockedDomains": [
    "*.1password.com",
    "*.lastpass.com",
    "*.bitwarden.com"
  ],
  "ThemeSeeds": {
    "primary": "#0ea5e9",
    "accent": "#10b981",
    "tertiary": "#8b5cf6",
    "neutralChroma": 0.2,
    "vibrancy": 1,
    "radius": 10,
    "depth": 1,
    "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
    "fontFamilyMono": "JetBrains Mono, monospace"
  },
  "Icons": {
    "Icon16": "icons/icon-16.png",
    "Icon32": "icons/icon-32.png",
    "Icon48": "icons/icon-48.png",
    "Icon128": "icons/icon-128.png"
  },
  "SuggestedPrompts": [
    "Highlight the next button I need to click on this screen",
    "Walk me through this setup workflow step by step",
    "Explain the key concepts on this page"
  ]
}
