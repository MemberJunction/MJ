{
  "BrandSlug": "betty",
  "BrandName": "Betty — Association Intelligence Sidekick",
  "ShortName": "Betty",
  "Version": "6.2.0",
  "Description": "Association & community intelligence companion uniting member profiles, chapter engagement, events, and committee records.",
  "AssistantDisplayName": "Betty",
  "Tagline": "Association & Community Intelligence Sidekick",
  "DefaultControlBackend": "content-script",
  "IncludeDebuggerPermission": false,
  "HostPermissions": [
    "<all_urls>"
  ],
  "ExternallyConnectableMatches": [
    "https://*.memberjunction.com/*",
    "http://localhost:*/*"
  ],
  "BlockedDomains": [
    "*.1password.com",
    "*.lastpass.com",
    "*.bitwarden.com"
  ],
  "ThemeSeeds": {
    "primary": "#7c3aed",
    "accent": "#f59e0b",
    "tertiary": "#ec4899",
    "neutralChroma": 0.3,
    "vibrancy": 1.1,
    "radius": 12,
    "depth": 1,
    "fontFamily": "Plus Jakarta Sans, system-ui, -apple-system, sans-serif",
    "fontFamilyMono": "JetBrains Mono, monospace"
  },
  "Icons": {
    "Icon16": "icons/icon-16.png",
    "Icon32": "icons/icon-32.png",
    "Icon48": "icons/icon-48.png",
    "Icon128": "icons/icon-128.png"
  },
  "SuggestedPrompts": [
    "Check this person's association membership tier and chapter",
    "Show upcoming association events for this member",
    "Update member title and organization from this profile"
  ]
}
