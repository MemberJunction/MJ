{
  "name": "@memberjunction/testing-integration",
  "type": "module",
  "version": "6.1.0-edge.5",
  "description": "MemberJunction Integration Test bootstrap library, IntegrationCheck registry, and IntegrationTestDriver. Installs an instrumented LocalCacheManager as the first caller and owns its process.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "dependencies": {
    "@memberjunction/core": "6.1.0-edge.5",
    "@memberjunction/core-entities": "6.1.0-edge.5",
    "@memberjunction/global": "6.1.0-edge.5",
    "@memberjunction/testing-engine": "6.1.0-edge.5",
    "@memberjunction/testing-engine-base": "6.1.0-edge.5",
    "@memberjunction/generic-database-provider": "6.1.0-edge.5",
    "@memberjunction/sqlserver-dataprovider": "6.1.0-edge.5",
    "@memberjunction/graphql-dataprovider": "6.1.0-edge.5",
    "@memberjunction/server-bootstrap-lite": "6.1.0-edge.5",
    "cosmiconfig": "9.0.0",
    "dotenv": "17.2.4",
    "mssql": "^12.2.0"
  },
  "optionalDependencies": {
    "@memberjunction/postgresql-dataprovider": "6.1.0-edge.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@types/mssql": "^9.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/bootstrap-client.d.ts",
      "default": "./dist/bootstrap-client.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./checks/*": {
      "types": "./dist/checks/*.d.ts",
      "default": "./dist/checks/*.js"
    }
  }
}
