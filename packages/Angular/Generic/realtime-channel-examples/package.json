  "typings": "./dist/public-api.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.spec.json",
    "build": "ngc",
    "test:watch": "vitest"
  },
  "keywords": [
    "angular",
    "realtime",
    "channel",
    "example",
    "memberjunction"
  ],
  "author": "MemberJunction",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@angular/compiler": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
