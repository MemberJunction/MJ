{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": ["es2022", "dom"],
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": [".harness"]
}
