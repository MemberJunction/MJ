{
  "name": "@memberjunction/ng-rich-text-editor",
  "version": "6.1.0-edge.5",
  "description": "MemberJunction: DOM-native WYSIWYG rich text editor. The contenteditable DOM is the document — no internal model, no schema, no re-normalization sweeps — so untouched HTML (Outlook/Gmail reply chains, tables, conditional comments) survives load→edit→serialize. Ships an Angular-free engine plus <mj-rich-text-editor>, a ControlValueAccessor with a design-token toolbar.",
  "main": "./dist/public-api.js",
  "typings": "./dist/public-api.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "ngc",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.spec.json",
    "test:watch": "vitest",
    "test:live": "playwright test --config e2e/playwright.config.ts",
    "test:live:types": "tsc --noEmit -p e2e/tsconfig.json",
    "playground": "tsx e2e/playground/serve.ts"
  },
  "keywords": [
    "memberjunction",
    "angular",
    "rich-text",
    "wysiwyg",
    "contenteditable",
    "editor",
    "email"
  ],
  "author": "",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@memberjunction/ng-test-utils": "6.1.0-edge.5",
    "@playwright/test": "^1.58.1",
    "@types/node": "24.10.11",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@angular/common": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3"
  },
  "dependencies": {
    "@memberjunction/ng-ui-components": "6.1.0-edge.5",
    "dompurify": "^3.3.0",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "mjUILayer": "widgets",
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  }
}
