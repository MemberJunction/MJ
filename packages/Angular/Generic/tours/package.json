{
  "name": "@memberjunction/ng-tours",
  "version": "6.3.0-edge.2",
  "description": "MemberJunction Guided Tours L1+L2 Light DOM Angular renderers, presenters, anchor registry, and two-stage <mj-tour-host> custom element.",
  "main": "./dist/public-api.js",
  "typings": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./core-anchor-manifest.json": "./dist/core-anchor-manifest.json"
  },
  "files": [
    "/dist",
    "/src/core-anchor-manifest.json"
  ],
  "scripts": {
    "prebuild": "node scripts/build-global-styles.mjs",
    "build": "ngc && node scripts/copy-assets.mjs && node scripts/build-element.mjs",
    "pretest": "node scripts/build-global-styles.mjs",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.spec.json",
    "test:watch": "vitest"
  },
  "keywords": [
    "MemberJunction",
    "Angular",
    "Guided Tours",
    "Onboarding",
    "Custom Element"
  ],
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
