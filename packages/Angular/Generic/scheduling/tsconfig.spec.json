    "src/lib/panels/scheduled-job-editor/scheduled-job-editor.component.dom.test.ts",
    "src/lib/panels/scheduled-job-summary/scheduled-job-summary.component.dom.test.ts",
    "src/lib/slide-panel/scheduled-job-slide-panel.component.ts",
    "src/lib/slide-panel/scheduled-job-slide-panel.component.dom.test.ts",
    "src/lib/dialogs/scheduled-job-dialog.component.ts",
    "src/lib/dialogs/scheduled-job-dialog.component.dom.test.ts"
