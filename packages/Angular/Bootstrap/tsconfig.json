{
  "extends": "../../../tsconfig.angular.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "composite": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,
    "paths": {
      "@memberjunction/ng-bootstrap/types": ["./types/src/index.ts"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
