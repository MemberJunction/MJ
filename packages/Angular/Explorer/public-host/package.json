      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "files": [
    "/dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.spec.json",
    "build": "ngc"
  },
  "keywords": [],
  "author": "",
  "license": "BUSL-1.1",
