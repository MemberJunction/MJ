{
  "name": "@memberjunction/ng-public-host",
  "version": "6.3.0-edge.2",
  "description": "MemberJunction: Hosts public pages from Open Apps that visitors open before sign-in, and the main.ts hook that starts them.",
  "main": "./dist/public-api.js",
  "typings": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
