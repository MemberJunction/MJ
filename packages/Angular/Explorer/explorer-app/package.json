{
  "name": "@memberjunction/ng-explorer-app",
  "version": "6.1.0-edge.0",
  "description": "MemberJunction Explorer Application Shell - Complete branded entry point for Explorer-style applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "ngc && npm run copy-assets",
    "copy-assets": "cpy 'src/lib/styles/**' dist/styles --flat && cpy 'src/lib/assets/**' dist/assets && cpy src/lib/styles.scss dist --flat",
    "watch": "ngc --watch",
    "clean": "rimraf dist",
    "build:clean": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "memberjunction",
    "angular",
    "explorer",
    "application",
    "shell"
  ],
  "author": "MemberJunction",
  "license": "MIT",
  "dependencies": {
    "@memberjunction/ai-agent-client": "6.1.0-edge.0",
    "@memberjunction/ai-core-plus": "6.1.0-edge.0",
    "@memberjunction/core": "6.1.0-edge.0",
    "@memberjunction/core-entities": "6.1.0-edge.0",
    "@memberjunction/ng-agent-client": "6.1.0-edge.0",
    "@memberjunction/ng-auth-services": "6.1.0-edge.0",
    "@memberjunction/ng-base-application": "6.1.0-edge.0",
    "@memberjunction/ng-base-types": "6.1.0-edge.0",
    "@memberjunction/ng-bootstrap": "6.1.0-edge.0",
    "@memberjunction/ng-conversations": "6.1.0-edge.0",
    "@memberjunction/ng-explorer-core": "6.1.0-edge.0",
    "@memberjunction/ng-explorer-service-worker": "6.1.0-edge.0",
    "@memberjunction/ng-feedback": "6.1.0-edge.0",
    "@memberjunction/ng-notifications": "6.1.0-edge.0",
    "@memberjunction/ng-shared": "6.1.0-edge.0",
    "@memberjunction/ng-workspace-initializer": "6.1.0-edge.0"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/common": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  },
  "mjUILayer": "shell"
}
