  "license": "ISC",
  "dependencies": {
    "@memberjunction/core": "6.1.0-edge.2",
    "@memberjunction/core-entities": "6.1.0-edge.2",
    "@memberjunction/global": "6.1.0-edge.2",
    "@memberjunction/sql-dialect": "6.1.0-edge.2",
    "@memberjunction/sql-parser": "6.1.0-edge.2"
  },
  "devDependencies": {
    "@types/node": "24.10.11",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "repository": {
    "type": "git",
