      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.TokenRefreshStrategy",
      "Excerpt": "This function can be used to exchange a refresh token for a new access token and refresh token... The response will contain a new 'access_token' and 'refresh_token'. / refresh_token -- The response body returns a new refresh_token value."
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "Access token lifetime (1440 min / 86,400 sec) for Configuration.AccessTokenLifetimeSeconds",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AccessTokenLifetimeSeconds",
      "Excerpt": "Access tokens automatically expire 1440 minutes (86,400 seconds). Making an API call with an expired access token returns a 401 unauthorized status code."
    },
