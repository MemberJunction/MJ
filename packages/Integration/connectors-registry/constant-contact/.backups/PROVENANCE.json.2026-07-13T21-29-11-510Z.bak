    {
      "URL": "https://developer.constantcontact.com/api_guide/rate_limits.html",
      "AccessedAt": "2026-07-11T23:05:00.000Z",
      "UsedFor": "Full RateLimitPolicy shape: daily cap, reset time, throttle status code, and the two distinct error_key values returned per limit type",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.RateLimitPolicy",
      "Excerpt": "If you exceed the 10,000 request per day quota the response body is: {\"error_key\":\"quota_exceeded\",\"error_message\":\"Limit Exceeded\"} If you exceed the rate of 4 requests per second the response body is: {\"error_key\":\"throttled\",\"error_message\":\"Too Many Requests\"}"
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "OAuth2 Authorization Code flow: authorization + token endpoint URLs and flow shape for Configuration.AuthFlow / Configuration.OAuthEndpoints / CredentialTypeID resolution",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthFlow",
      "Excerpt": "To create an authorization request, make a GET call to the authorization endpoint https://authz.constantcontact.com/oauth2/default/v1/authorize ... Make a POST request to the https://authz.constantcontact.com/oauth2/default/v1/token token endpoint to exchange the authorization code for an access and refresh token."
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "OAuth2 endpoint URLs for Configuration.OAuthEndpoints",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.OAuthEndpoints",
      "Excerpt": "authorization endpoint https://authz.constantcontact.com/oauth2/default/v1/authorize ... token endpoint https://authz.constantcontact.com/oauth2/default/v1/token"
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "ROTATING refresh-token behavior for Configuration.TokenRefreshStrategy / TokenRefreshStrategyNote -- the connector must persist the newest refresh_token on every exchange",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.TokenRefreshStrategy",
      "Excerpt": "This function can be used to exchange a refresh token for a new access token and refresh token... The response will contain a new 'access_token' and 'refresh_token'. / refresh_token -- The response body returns a new refresh_token value."
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "Access token lifetime (1440 min / 86,400 sec) for Configuration.AccessTokenLifetimeSeconds",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AccessTokenLifetimeSeconds",
      "Excerpt": "Access tokens automatically expire 1440 minutes (86,400 seconds). Making an API call with an expired access token returns a 401 unauthorized status code."
    },
    {
      "URL": "https://developer.constantcontact.com/api_guide/server_flow.html",
      "AccessedAt": "2026-07-11T23:06:00.000Z",
      "UsedFor": "offline_access scope required to receive a refresh_token at all, for Configuration.OAuthEndpoints.offlineAccessScopeRequiredForRefreshToken",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.OAuthEndpoints",
      "Excerpt": "The offline_access scope is required to get a refresh token."
    },
    {
