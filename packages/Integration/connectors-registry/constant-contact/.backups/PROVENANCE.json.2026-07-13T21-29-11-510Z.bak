      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthHeaderPattern",
      "Excerpt": "Header: Authorization | Accepted Values: Bearer {access_token} | Comment: The access_token generated during the grant access leg of the OAuth2 flow"
