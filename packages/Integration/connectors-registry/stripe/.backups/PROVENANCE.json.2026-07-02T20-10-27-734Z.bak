    },
    {
      "URL": "https://docs.stripe.com/rate-limits",
      "AccessedAt": "2026-07-02T19:00:00.000Z",
      "UsedFor": "Confirming Stripe's documented per-account rate limit used to populate BatchMaxRequestCount / BatchRequestWaitTime and Configuration.RateLimitPolicy.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.BatchMaxRequestCount",
      "Excerpt": "In live mode, your account can send 100 requests per second... In sandboxes (test mode), the limit is 25 requests per second. If you exceed this, Stripe returns a 429 error with a Stripe-Rate-Limited-Reason header identifying which limit (global-rate, endpoint-rate, global-concurrency, endpoint-concurrency, resource-specific) was breached. Documented per-resource overrides include Payment Intents (1000 updates per PI per hour), Subscriptions (10 new invoices per subscription per minute, 20 per day), Payouts (15 creates per second), and the Files API (20 read+write requests per second)."
    },
