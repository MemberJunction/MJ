    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "BatchRequestWaitTime = 60 seconds: 429 response description states \"Wait for a minute and try again\" — implies 60-second window. BatchMaxRequestCount left null because exact request count per window is not stated.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ImpliedFromExample",
      "TargetField": "integration.BatchRequestWaitTime",
      "Excerpt": "\"tooManyRequests\": {\"description\": \"Too many requests from same account. Wait for a minute and try again.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.AuthFlow = oauth2-cc (client_credentials) and Configuration.tokenUrl. The OAuth2_clientCredentials security scheme has flows.clientCredentials.tokenUrl = \"https://oauth.wildapricot.org/auth/token\".",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthFlow",
      "Excerpt": "\"OAuth2_clientCredentials\": {\"type\": \"oauth2\", \"flows\": {\"clientCredentials\": {\"tokenUrl\": \"https://oauth.wildapricot.org/auth/token\", \"scopes\": {\"auto\": \"autodetect allowed scopes based on current user permissions\"}}}}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.tokenUrl = https://oauth.wildapricot.org/auth/token. Confirmed by all three security scheme flows using the same token URL.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.tokenUrl",
      "Excerpt": "\"tokenUrl\": \"https://oauth.wildapricot.org/auth/token\""
    },
    {
      "URL": "https://gethelp.wildapricot.com/en/articles/484-api-authentication",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Confirms auth mechanism: API key used as Basic auth username (empty password) on POST to tokenUrl. Describes client_credentials grant_type and scope=auto.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.authNote",
      "Excerpt": "clientId=APIKEY&clientSecret=<your_api_key> — API key used as clientId+clientSecret on Basic-auth token request."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.AuthHeaderPattern = Authorization: Bearer <token>. The OpenAPI security scheme type is oauth2; the bearer token pattern is the standard OAuth2 bearer pattern confirmed by the spec.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthHeaderPattern",
      "Excerpt": "Security scheme type: \"oauth2\" with clientCredentials flow; standard Bearer token authorization."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.PaginationDefaults: type=Offset, $skip param, $top param, maxPageSize=100. pagingSkip and pagingTop shared components explicitly define the OData-style $skip/$top params. pagingTop description states max 100.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.PaginationDefaults",
      "Excerpt": "\"pagingSkip\": {\"name\": \"$skip\", ...}, \"pagingTop\": {\"name\": \"$top\", \"description\": \"If omitted or set more than 100 then maximum 100 items returned.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.IncrementalSyncCapability: contacts support $filter on ProfileLastUpdated (watermark-based). The Contact schema has ProfileLastUpdated field (\"Timestamp of last contact details modification\").",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.IncrementalSyncCapability",
      "Excerpt": "\"ProfileLastUpdated\": {\"type\": \"string\", \"description\": \"Timestamp of last contact details modification. Complies with ISO8601 format.\"}"
    },
