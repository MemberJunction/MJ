{
  "Entries": [
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "APIBaseURL and APIVersioningStrategy: servers[0].url = \"https://api.wildapricot.org/v2.3\" establishes the base URL and confirms version-in-path strategy.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.APIBaseURL",
      "Excerpt": "\"servers\": [{\"url\": \"https://api.wildapricot.org/v2.3\"}]"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "APIVersioningStrategy = url-path: version is embedded as /v2.3/ path segment.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.APIVersioningStrategy",
      "Excerpt": "\"servers\": [{\"url\": \"https://api.wildapricot.org/v2.3\"}] — version in URL path segment."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "BatchRequestWaitTime = 60 seconds: 429 response description states \"Wait for a minute and try again\" — implies 60-second window. BatchMaxRequestCount left null because exact request count per window is not stated.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ImpliedFromExample",
      "TargetField": "integration.BatchRequestWaitTime",
      "Excerpt": "\"tooManyRequests\": {\"description\": \"Too many requests from same account. Wait for a minute and try again.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.AuthFlow = oauth2-cc (client_credentials) and Configuration.tokenUrl. The OAuth2_clientCredentials security scheme has flows.clientCredentials.tokenUrl = \"https://oauth.wildapricot.org/auth/token\".",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthFlow",
      "Excerpt": "\"OAuth2_clientCredentials\": {\"type\": \"oauth2\", \"flows\": {\"clientCredentials\": {\"tokenUrl\": \"https://oauth.wildapricot.org/auth/token\", \"scopes\": {\"auto\": \"autodetect allowed scopes based on current user permissions\"}}}}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.tokenUrl = https://oauth.wildapricot.org/auth/token. Confirmed by all three security scheme flows using the same token URL.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.tokenUrl",
      "Excerpt": "\"tokenUrl\": \"https://oauth.wildapricot.org/auth/token\""
    },
    {
      "URL": "https://gethelp.wildapricot.com/en/articles/484-api-authentication",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Confirms auth mechanism: API key used as Basic auth username (empty password) on POST to tokenUrl. Describes client_credentials grant_type and scope=auto.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.authNote",
      "Excerpt": "clientId=APIKEY&clientSecret=<your_api_key> — API key used as clientId+clientSecret on Basic-auth token request."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.AuthHeaderPattern = Authorization: Bearer <token>. The OpenAPI security scheme type is oauth2; the bearer token pattern is the standard OAuth2 bearer pattern confirmed by the spec.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.AuthHeaderPattern",
      "Excerpt": "Security scheme type: \"oauth2\" with clientCredentials flow; standard Bearer token authorization."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.PaginationDefaults: type=Offset, $skip param, $top param, maxPageSize=100. pagingSkip and pagingTop shared components explicitly define the OData-style $skip/$top params. pagingTop description states max 100.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.PaginationDefaults",
      "Excerpt": "\"pagingSkip\": {\"name\": \"$skip\", ...}, \"pagingTop\": {\"name\": \"$top\", \"description\": \"If omitted or set more than 100 then maximum 100 items returned.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.IncrementalSyncCapability: contacts support $filter on ProfileLastUpdated (watermark-based). The Contact schema has ProfileLastUpdated field (\"Timestamp of last contact details modification\").",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.IncrementalSyncCapability",
      "Excerpt": "\"ProfileLastUpdated\": {\"type\": \"string\", \"description\": \"Timestamp of last contact details modification. Complies with ISO8601 format.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "IncrementalSyncCapability: AuditLogItems supports StartDate/EndDate time-range params for incremental pull.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.IncrementalSyncCapability",
      "Excerpt": "\"StartDate\": {\"in\": \"query\", \"description\": \"Limits result to log items created since StartDate.\", \"schema\": {\"type\": \"string\", \"format\": \"date\"}}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.TokenRefreshStrategy: client_credentials grant has no refresh_token. Must re-issue token when expired.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.TokenRefreshStrategy",
      "Excerpt": "\"clientCredentials\" flow — no refresh_token in OAuth2 client_credentials grant type by specification."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.WebhooksAvailable = false. No webhook paths in the 84-path spec. The term \"webhook\" does not appear in the spec at all.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.WebhooksAvailable",
      "Excerpt": "Spec has 84 paths. grep for \"webhook\" returns 0 matches. No webhook management endpoints."
    },
    {
      "URL": "https://gethelp.wildapricot.com/en/articles/182-using-wildapricot-s-api",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.BulkOperationsAvailable = false. The BATCH method mentioned in overview article 182 is not represented in the v9.14.0 OpenAPI spec paths. No BATCH endpoints in the machine-readable spec.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ImpliedFromExample",
      "TargetField": "integration.Configuration.BulkOperationsAvailable",
      "Excerpt": "Article 182 mentions BATCH method but it is absent from the v9.14.0 OpenAPI spec (84 paths, no BATCH path found)."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.ErrorResponseShape: Error schema has code (string), message (string), details (object). 401, 404, 429 responses documented.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.ErrorResponseShape",
      "Excerpt": "\"Error\": {\"type\": \"object\", \"required\": [\"code\", \"message\"], \"properties\": {\"code\": {\"type\": \"string\", \"description\": \"Error code, like Validation / Search / ...\"}, \"message\": {\"type\": \"string\"}, \"details\": {\"type\": \"object\"}}}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.WriteCapability: spec has POST/PUT/DELETE verbs on Contacts, Events, EventRegistrationTypes, EventRegistrations, Invoices, Payments, Refunds, Tenders, DonationFields, ContactFields, Products, CeuRecords. Donations has no DELETE.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.WriteCapability",
      "Excerpt": "POST /accounts/{accountId}/contacts; PUT /accounts/{accountId}/contacts/{contactId}; DELETE /accounts/{accountId}/contacts/{contactId}; etc. — CRUD verbs confirmed across major entity paths."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.ConcurrencyControl = none. No ETag, If-Match, or version field found anywhere in the 84-path spec (0 matches for ETag/If-Match/version in response schemas or headers).",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.ConcurrencyControl",
      "Excerpt": "No response headers in spec. No ETag/If-Match pattern. No version field in any entity schema."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.DeleteSemantics: contacts use soft-delete (archive). DELETE /contacts/{contactId} description: \"Delete an archived contact\". excludeArchived query param on saved-search confirms archived contacts remain in DB.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.DeleteSemantics",
      "Excerpt": "\"delete\": {\"tags\": [\"Contacts\"], \"description\": \"Delete an archived contact\"} and excludeArchived param: \"exclude archived contacts from found ContactIDs\""
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.CustomFieldMarkerPattern: IsBuiltIn flag on ContactFieldDescription; IsSystem flag on EntityFieldDescription. System/built-in = not deletable. Custom = IsSystem=false AND IsBuiltIn=false.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.CustomFieldMarkerPattern",
      "Excerpt": "\"IsBuiltIn\": {\"type\": \"boolean\", \"description\": \"The field is a built-in system field, it cannot be edited or deleted.\"} and \"IsSystem\": {\"type\": \"boolean\", \"description\": \"Field is system-defined and could not be deleted.\"}"
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.DefaultSyncDirection = Pull (read-only by default per discipline). Configuration.DefaultConflictResolution = DestWins (no ETag/version → MostRecent not safe; DestWins avoids accidental overwrites).",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ImpliedFromExample",
      "TargetField": "integration.Configuration.DefaultSyncDirection",
      "Excerpt": "Per MetadataWriter discipline: all objects default to Pull. Write paths exist (CRUD verbs in spec) but require explicit opt-in per bidirectional policy."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.universalPK: fieldName = Id (integer). All entity schemas use Id as integer PK (Contact.Id, Event.Id, Invoice.Id, etc.).",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.universalPK",
      "Excerpt": "\"Id\": {\"type\": \"integer\", \"description\": \"Unique contact identifier.\"} (Contact); \"Id\": {\"type\": \"integer\"} (Event, Invoice, Payment, etc.) — consistent integer Id PK across all entity types."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "OutOfScopeObjectFamilies[0] = Webhook delivery: no webhook paths in spec, \"webhook\" string absent from entire 212KB spec.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.OutOfScopeObjectFamilies",
      "Excerpt": "84 paths in spec; zero match \"webhook\". Confirmed absent."
    },
    {
      "URL": "https://gethelp.wildapricot.com/en/articles/484-api-authentication",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "OutOfScopeObjectFamilies[1] = OAuth authorization_code multi-tenant app flow: documented in auth article 484 as a separate flow for multi-tenant apps. Not applicable to single-admin-connection connector using client_credentials.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.OutOfScopeObjectFamilies",
      "Excerpt": "Article 484 describes authorization_code flow as for \"Wild Apricot authorized applications\" (multi-tenant OAuth apps), distinct from API key / client_credentials used by admin integrations."
    },
    {
      "URL": "https://api.swaggerhub.com/apis/WildApricot/wild-apricot_public_api/9.14.0-oas3",
      "AccessedAt": "2026-06-30T19:17:13.642Z",
      "UsedFor": "Configuration.accountIdDiscovery: GET /accounts endpoint (no accountId in path) lists all accounts accessible to the token. Used when AccountId credential field is omitted.",
      "SourceTier": 1,
      "SourceCategory": "OpenAPISpec",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.accountIdDiscovery",
      "Excerpt": "\"GET /accounts\": {\"summary\": \"List of current user accounts\"} — returns account list; first account Id is used as tenant anchor."
    },
