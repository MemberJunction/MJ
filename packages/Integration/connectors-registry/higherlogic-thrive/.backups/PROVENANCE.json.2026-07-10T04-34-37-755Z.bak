    },
    {
      "URL": "https://support.higherlogic.com/hc/en-us/articles/4402952237844-OAuth-2-0-Code-Flow",
      "AccessedAt": "2026-07-08T00:00:00.000Z",
      "UsedFor": "Setting Configuration.OutOfScopeObjectFamilies entry for SSO, and Configuration.EndUserSSOMechanisms distinguishing SSO from the connector's server-to-server auth.",
      "SourceTier": 1,
      "SourceCategory": "OfficialDocs",
      "EvidenceStrength": "ExplicitStatement",
      "TargetField": "integration.Configuration.EndUserSSOMechanisms",
      "Excerpt": "OAuth 2.0 Code Flow at Higher Logic is an SSO/end-user-login mechanism (authorize/token/userinfo endpoints against an external Identity Provider, resolving a 'legacy identifier' claim to log a user into the Community) -- not a route for server-to-server API data sync."
    },
