{
  "extends": "../../../tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["office-js"]
