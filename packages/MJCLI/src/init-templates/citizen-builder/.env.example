# ==============================================================================
# MemberJunction Citizen Agent Builder - settings
#
# After changing anything here, run:  docker compose up -d
# (Setup reads this file again on every start, so a restart picks up new keys.)
# ==============================================================================

# ---- 1. FILL THESE IN ---------------------------------------------------------

# An API key for at least one AI provider, so your agents can call a model.
# Anthropic: create the key at https://console.anthropic.com/settings/keys.
# A key created inside a workspace works as it is. A key that is not scoped to
# a workspace also needs ANTHROPIC_WORKSPACE_ID: the ID of the workspace to
# bill (Anthropic console > Settings > Workspaces).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# You: the email you sign in to Explorer with. This account is the workspace's
# owner. Anyone who signs in gets the Developer role, so you can run the agents
# you build from the web app; the ports only accept connections from this machine.
OWNER_EMAIL=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=

# Sign-in for the Explorer web app. Fill in ONE provider; your organization's
# IT or platform team usually supplies these. Register http://localhost:4202
# (or your EXPLORER_PORT) as a single-page-app redirect URI.
# Microsoft Entra ID:
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Auth0:
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# A GitHub token with read access to public repositories. Optional for the
# public sample data, which installs within GitHub's anonymous allowance
# (60 requests an hour); needed for a private sample data repository. If the
# allowance runs out anyway, setup waits for it and says so in .mj-status.json.
GITHUB_TOKEN=

# ---- 2. SET BY `mj agent init` -------------------------------------------------

# The MemberJunction release to install. Must match the CLI that scaffolded
# this workspace.
MJ_VERSION=

# Names this workspace's containers and volumes, so two workspaces on one
# machine never share a database.
COMPOSE_PROJECT_NAME=

# Encrypts sensitive fields. 32 random bytes, base64-encoded
# (`openssl rand -base64 32`). Left empty, one is generated and kept with the
# workspace's data.
MJ_BASE_ENCRYPTION_KEY=

# Ports on your machine. `mj agent init` picks free ones.
DB_PORT=1433
API_PORT=4000
EXPLORER_PORT=4202

# ---- 3. USUALLY LEFT ALONE -----------------------------------------------------

# The local SQL Server's administrator password and database name.
DB_PASSWORD=TestPassword123!
DB_DATABASE=MemberJunction

# The Open App that supplies business entities and sample data. The default is
# MemberJunction's More Cheese demo. Point it at your organization's sample-data
# app (see docs/ENTERPRISE_ORG_SETUP.md), or set it to `none` for no sample data.
OPEN_APP_INSTALL_URL=https://github.com/MemberJunction/more-cheese
