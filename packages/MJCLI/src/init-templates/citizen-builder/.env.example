# ==============================================================================
# MemberJunction Citizen Agent Builder Environment Configuration
# ==============================================================================

# MemberJunction Version
# The release this workspace runs: both the CLI inside the container and the MemberJunction
# install it creates. `mj agent init` sets it to its own version so the container matches the CLI
# that scaffolded the workspace. To move to another release, change it and run: docker compose build
MJ_VERSION=

# Database Configuration
DB_PASSWORD=TestPassword123!
DB_PORT=1433
DB_DATABASE=MemberJunction
API_PORT=4000
# Explorer port (use 4202 if 4200 is in use, as 4202 is an authorized redirect URI for Auth0/MSAL)
EXPLORER_PORT=4202

# Security
MJ_BASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# LLM Provider API Keys (Provide at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Business Context / Open App Configuration
# Default: More Cheese (public reference app with 9 business packages + synthetic data)
OPEN_APP_INSTALL_URL=https://github.com/MemberJunction/more-cheese

# Enterprise Private Repository Access (e.g., Blue Cypress / BC)
# If your organization uses private Open Apps, specify a read-only GitHub token:
# GITHUB_TOKEN=ghp_yourOrgReadTokenHere
# OPEN_APP_INSTALL_URL=https://github.com/BlueCypress/bc-sampledata
