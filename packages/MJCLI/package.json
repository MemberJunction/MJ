{
  "name": "@memberjunction/cli",
  "type": "module",
  "version": "6.1.0",
  "description": "MemberJunction command line tools",
  "keywords": [
    "oclif"
  ],
  "homepage": "https://github.com/MemberJunction/MJ",
  "bugs": {
    "url": "https://github.com/MemberJunction/MJ/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/MJ"
  },
  "license": "BUSL-1.1",
  "author": "MemberJunction",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mj": "bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "/regression-compose"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f && oclif manifest && node scripts/copy-regression-assets.mjs",
    "prepack": "npm run build && oclif readme",
    "postpack": "rimraf oclif.manifest.json",
    "version": "oclif readme && git add README.md",
    "test": "vitest run"
  },
  "oclif": {
    "bin": "mj",
    "commands": "./dist/commands",
    "hooks": {
      "init": "./dist/hooks/init",
      "prerun": "./dist/hooks/prerun",
      "postrun": "./dist/hooks/postrun"
    },
    "dirname": "mj",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-version"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 1
    }
  },
