{
  "name": "@memberjunction/server-bootstrap-lite",
  "version": "6.1.0-edge.6",
  "description": "MemberJunction Server Bootstrap (Lite) - Class registrations manifest without ESM-incompatible dependencies (communication, storage)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mj-class-registrations": {
      "types": "./dist/mj-class-registrations.d.ts",
      "default": "./dist/mj-class-registrations.js"
    }
  },
  "scripts": {
    "prebuild": "if [ -d dist ]; then node ../../packages/MJCLI/bin/run.js codegen manifest --exclude-packages @memberjunction/communication --exclude-packages @memberjunction/content-autotagging --exclude-packages @memberjunction/entity-communications --exclude-packages @memberjunction/queue --exclude-packages @memberjunction/storage --exclude-packages @memberjunction/server --output ./src/generated/mj-class-registrations.ts || echo 'Warning: workspace CLI not built yet (build @memberjunction/cli first), using existing manifest'; else touch .needs-manifest-rebuild; fi",
    "build": "tsc && tsc-alias -f",
    "postbuild": "if [ -f .needs-manifest-rebuild ]; then rm .needs-manifest-rebuild && (node ../../packages/MJCLI/bin/run.js codegen manifest --exclude-packages @memberjunction/communication --exclude-packages @memberjunction/content-autotagging --exclude-packages @memberjunction/entity-communications --exclude-packages @memberjunction/queue --exclude-packages @memberjunction/storage --exclude-packages @memberjunction/server --output ./src/generated/mj-class-registrations.ts && tsc && tsc-alias -f || echo 'Warning: workspace CLI not built yet (build @memberjunction/cli first), manifest will be generated on next build'); fi",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "memberjunction",
    "bootstrap",
    "server",
    "lite"
  ],
  "author": "MemberJunction",
  "license": "BUSL-1.1",
  "dependencies": {
    "@memberjunction/actions": "6.1.0-edge.6",
