# Regression stack settings. Copy to docker/regression/.env.test (gitignored) and fill in values:
#   cp docker/regression/.env.test.example docker/regression/.env.test
# REGRESSION_TESTING.md, "Environment Variables", describes each one.

# ── Required ────────────────────────────────────────────────────────────────
# SQL Server SA password: at least 8 characters, with upper case, lower case, a digit and a symbol.
TEST_SA_PASSWORD=
# Base64 key for MJ field encryption: openssl rand -base64 32
MJ_BASE_ENCRYPTION_KEY=

# Auth0 SPA application. It must allow http://localhost:4200 as a callback, logout URL and web origin.
AUTH0_DOMAIN=
AUTH0_CLIENTID=

# The Auth0 test user (email verified, no MFA). The tests read them as {{authUsername}} / {{authPassword}}.
TEST_UID=
TEST_PWD=

# At least one AI vendor key. Gemini is the primary Computer Use model, Anthropic the alternate.
AI_VENDOR_API_KEY__GeminiLLM=
AI_VENDOR_API_KEY__AnthropicLLM=

# ── Optional ────────────────────────────────────────────────────────────────
# Parallel browser workers in the test runner (default 4).
MAX_PARALLEL_WORKERS=4
# Suite to run (default "MJ Explorer Regression Suite").
TEST_SUITE_NAME=
# Auth0 application client secret. An SPA login does not use it: MJAPI checks tokens with the
# tenant's public keys.
AUTH0_CLIENT_SECRET=

# ── Open Apps (open-apps.json) ──────────────────────────────────────────────
# GitHub token for the Open App installs: rate limits and private repos. All pinned repos are
# public. Keep this line even when it is empty: the image builds read it as a BuildKit secret.
GITHUB_TOKEN=
# The MoreCheese shared key (from the MoreCheese team). Without it the Skip dashboards and the
# Knowledge Hub Dropbox source do not load.
MORECHEESE_SHARED_KEY=
# Copy each app's template user to a new user with this email. Leave empty: the test-user
# metadata push creates the test user itself and fails when it already exists.
MJ_INSTALL_USER_EMAIL=
