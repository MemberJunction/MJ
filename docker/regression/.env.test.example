# Regression test environment — TEMPLATE (placeholders only; safe to commit).
#
# Copy to .env.test in this same directory and fill in real values:
#   cp docker/regression/.env.test.example docker/regression/.env.test
#   # edit docker/regression/.env.test
#   mj test regression build
#   mj test regression up
#
# .env.test is gitignored — never commit it. It is loaded by `mj test
# regression *`, which passes it with `--env-file docker/regression/.env.test`
# (see packages/MJCLI .../docker-helpers.ts). It is NOT auto-read by a bare
# `docker compose` command — only the MJ CLI wires it in.
#
# Prefer NOT to paste raw secrets here: values of the form `env:VAR_NAME` are
# resolved from the process environment by the loader, so you can keep keys in
# your shell / a secret manager and reference them (e.g. TEST_PWD=env:TEST_PWD).

# ─── SQL Server / encryption ───────────────────────────────────────
# SQL Server SA password (8+ chars, mixed case + digit + symbol). This is the
# ephemeral test DB's SA password — the compose default is TestPassword123!.
TEST_SA_PASSWORD=TestPassword123!
# Base64 encryption key — generate with: openssl rand -base64 32
MJ_BASE_ENCRYPTION_KEY=<run: openssl rand -base64 32>

# ─── Auth0 (test user must be email-verified, no MFA) ──────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENTID=your-spa-client-id
AUTH0_CLIENT_SECRET=            # Not required for SPA + PKCE flow — leave blank
TEST_UID=test-user@example.com  # test user email in Auth0 (email-verified, no MFA)
TEST_PWD=env:TEST_PWD           # test user password (prefer env: indirection over a literal)

# ─── AI vendor keys ────────────────────────────────────────────────
# Gemini drives the default Computer Use controller AND the judge.
# Required unless every test overrides both prompts.
AI_VENDOR_API_KEY__GeminiLLM=env:AI_VENDOR_API_KEY__GeminiLLM

# Optional — alternate / failover controller.
AI_VENDOR_API_KEY__AnthropicLLM=env:AI_VENDOR_API_KEY__AnthropicLLM

# LMStudio runs on the host and the container reaches it via
# host.docker.internal. LMStudio doesn't enforce an API key by default;
# the compose file passes the literal "lm-studio" as a placeholder.
# Override only if you've configured LMStudio with a real key.
# AI_VENDOR_API_KEY__LMStudioLLM=lm-studio

# Override the LMStudio reachable URL (WS scheme — @lmstudio/sdk requires ws://).
# Defaulted in compose to ws://host.docker.internal:1234.
# LMSTUDIO_BASE_URL=ws://host.docker.internal:1234

# ─── Optional knobs ────────────────────────────────────────────────
# Parallel browser workers. Each needs ~1.5g; size against the runner mem_limit
# (default 7g fits ~3). 4 workers OOM'd the default-memory host historically.
# MAX_PARALLEL_WORKERS=3
# Extra attempts per failing test (0 disables). Also settable via `--retries`.
# MAX_RETRIES=2
# Resource-limit overrides (all optional; defaults live in docker-compose.test.yml):
# MJ_REGRESSION_SQL_MEM_LIMIT=4g
# MJ_REGRESSION_API_MEM_LIMIT=10g
# MJ_REGRESSION_RUNNER_MEM_LIMIT=7g
# RI-A1: composite build identity for the Computer Use replay tier. Normally
# minted host-side by `mj test regression up` (git SHA + schema fingerprint);
# set explicitly only to pin a reproducible build across runs (e.g. in CI).
# APP_BUILD_HASH=
# console verbosity for the Computer Use per-step stream.
# quiet | normal (default) | verbose. Affects the CONSOLE only — the test-run
# record, report, and diagnostics always receive every message. Warnings/errors
# are never filtered. Use verbose to debug one test's LLM behavior.
# CU_LOG_LEVEL=normal
