{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": { "signature": true },
  "globalDependencies": [
    "tsconfig.server.json"
  ],
  "tasks": {
    "build": {
      "outputs": ["build/**", "dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!src/**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!vitest.config.*"
      ],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["REDIS_URL", "REDIS_KEY_PREFIX", "REDIS_TTL_SECONDS", "GRAPHQL_PORT"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "env": ["REDIS_URL"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/__tests__/**",
        "vitest.config.*",
        "tsconfig.json",
        "tsconfig.spec.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.dom.shared.ts",
        "$TURBO_ROOT$/vitest.dom.setup.ts"
      ],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:types": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json",
        "tsconfig.spec.json"
      ],
      "cache": true
    }
  }
}
