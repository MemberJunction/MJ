{
  "name": "MyOpenTasks",
  "componentRole": "widget",
  "properties": [
    { "name": "maxItems", "type": "number", "required": false, "description": "Rows to show" },
    { "name": "statusFilter", "type": "string", "required": false, "possibleValues": ["Open", "Blocked"], "description": "Which tasks" }
  ],
  "events": [
    { "name": "taskOpened", "description": "User opened a task", "parameters": [{ "name": "taskId", "type": "string", "description": "Task ID" }] }
  ],
  "dataRequirements": {
    "mode": "views",
    "entities": [{
      "name": "MJ_BizApps_Tasks: Tasks",
      "displayFields": ["ID", "Name", "DueAt", "Status", "PercentComplete"],
      "fieldMetadata": [
        { "name": "ID", "type": "uniqueidentifier", "allowsNull": false, "isPrimaryKey": true },
        { "name": "Name", "type": "nvarchar", "allowsNull": false },
        { "name": "DueAt", "type": "datetimeoffset", "allowsNull": true },
        { "name": "Status", "type": "nvarchar", "allowsNull": false, "possibleValues": ["Open", "InProgress", "Blocked", "Completed", "Cancelled"] },
        { "name": "PercentComplete", "type": "int", "allowsNull": true },
        { "name": "BlockedReason", "type": "nvarchar", "allowsNull": true }
      ]
    }]
  },
  "dependencies": [{
    "name": "StatTile",
    "properties": [
      { "name": "label", "type": "string", "required": true },
      { "name": "value", "type": "number", "required": true },
      { "name": "tone", "type": "string", "required": false, "possibleValues": ["neutral", "warning", "danger"] }
    ]
  }]
}
