{
  "name": "surface",
  "class": "mj-surface",
  "inputs": {
    "Level":       { "type": "string",  "default": "base", "openAxis": { "builtin": ["sunken", "base", "elevated", "overlay"], "classPattern": "mj-surface-{value}" } },
    "Elevation":   { "type": "string",  "default": "none" },
    "Interactive": { "type": "boolean", "default": false, "class": "mj-surface-interactive" },
    "Selected":    { "type": "boolean", "default": false, "class": "is-selected" },
    "Padding":     { "type": "string",  "default": "md" },
    "Radius":      { "type": "string",  "default": "surface" },
    "Tone":        { "type": "string",  "default": "neutral" },
    "VisualRole":  { "type": "string",  "default": "surface" }
  },
  "parts": { "header": "mj-surface-header", "body": "mj-surface-body", "footer": "mj-surface-footer" },
  "exposedValues": { "properties": ["bg", "gap", "border", "border-width", "border-style", "radius", "padding", "shadow"], "states": ["hover", "selected", "focus"] }
}
