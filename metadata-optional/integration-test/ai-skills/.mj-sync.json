{
  "entity": "MJ: AI Skills",
  "filePattern": "**/.*.json",
  "defaults": {},
  "ignoreDirectories": [
    "templates"
  ],
  "pull": {
    "createNewFileIfNotFound": true,
    "newFileName": ".it-skills.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "backupBeforeUpdate": true,
    "backupDirectory": ".backups",
    "filter": "Name LIKE 'IT:%'",
    "ignoreNullFields": true,
    "ignoreVirtualFields": true,
    "lookupFields": {
      "CreatedByUserID": {
        "entity": "MJ: Users",
        "field": "Name"
      }
    },
    "relatedEntities": {
      "MJ: AI Skill Actions": {
        "entity": "MJ: AI Skill Actions",
        "foreignKey": "SkillID"
      },
      "MJ: AI Skill Sub Agents": {
        "entity": "MJ: AI Skill Sub Agents",
        "foreignKey": "SkillID"
      }
    }
  }
}
