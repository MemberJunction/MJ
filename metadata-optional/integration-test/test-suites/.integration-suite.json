[
  {
    "fields": {
      "Name": "Integration Tests",
      "Description": "Parent suite for the metadata-driven Integration Test TestType (graduated from packages/MJServer/integration-test-scripts). Tiering is expressed as sibling child suites: 'Integration Tests — Deterministic' is the credential-free, blocking tier; 'Integration Tests — Live Model' is the opt-in, token-costing tier. The mutation axis is NOT a separate suite — mutation checks live inside the deterministic suite's tests and are gated at runtime by the driver reading RUN_MUTATION_TESTS.",
      "Status": "Active"
    },
    "primaryKey": {
      "ID": "96B5E60F-C065-466D-85D9-1ACF778E2870"
    },
    "sync": {
      "lastModified": "2026-06-23T20:46:07.673Z",
      "checksum": "78c55807c83245a099f50213a6636a793b26bf411849dce92fe29cab188c1cfd"
    }
  },
  {
    "fields": {
      "Name": "Integration Tests — Deterministic",
      "ParentID": "@lookup:MJ: Test Suites.Name=Integration Tests",
      "Description": "The blocking, credential-free integration tier. Members run with no LLM credentials against a live DB/transport. Mutation-class checks (S17/S23/S24, C10) are ordinary members gated at runtime by RUN_MUTATION_TESTS — they appear here but only fire when the driver sees the env gate. IT03 (client/GraphQL) is seeded Skip until MJAPI is provisioned in CI (Phase 5). ORDERING INVARIANT: client-transport members are sequenced LAST — bootstrapIntegrationClient rebinds the process's global provider to GraphQL, so no server-transport member may run after the first client one.",
      "Status": "Active"
    },
