        }
      },
      {
        "kind": "action",
        "actions": [
          {
            "name": "Get Entity Details"
          }
        ],
        "allowAdditionalActions": true
      },
      {
        "kind": "action",
        "actions": [
          {
            "name": "Search Query Catalog"
          }
        ],
        "allowAdditionalActions": true
      }
    ]
  }
}
