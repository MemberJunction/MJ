{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MemberJunction/MJ/next/ci/release-lines.schema.json",
  "title": "MemberJunction release lines",
  "description": "One source of truth for release channels, certified lines, and per-era platform manifests. See plans/lts-process.md §4.1. Status transitions merge only via PR (CODEOWNERS-gated); publish workflows may append mechanical fields (edge.newest, lines.*.newest, lines.*.releases) only. ci/validate-release-lines.mjs is the authoritative CI validator; this schema serves editors and external tooling.",
  "type": "object",
  "required": ["edge", "eras", "lines"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "edge": {
      "type": "object",
      "required": ["newest"],
      "additionalProperties": false,
      "properties": {
        "newest": {
          "description": "Newest Edge prerelease (X.Y.Z-edge.N), or null before the first Edge-era release.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-edge\\.\\d+$" }
          ]
        }
      }
    },
    "eras": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^\\d+$": {
          "type": "object",
          "required": ["platform"],
          "additionalProperties": false,
          "properties": {
            "platform": {
              "description": "The era's infrastructure contract: exact or range pins for Angular, Node, TypeScript, zone.js, pnpm, etc. mj app tooling derives npm overrides from this block.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\d+\\.\\d+$": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["candidate", "certified", "maintenance", "eol", "withdrawn"] },
            "certifiedBuild": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "newest": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "candidateDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "certifiedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "supportEnds": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "upgradeImpact": { "enum": ["none", "config", "breaking"] },
            "releases": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^\\d+\\.\\d+\\.\\d+$": {
                  "type": "object",
                  "required": ["dbImpact"],
                  "additionalProperties": false,
                  "properties": {
                    "dbImpact": { "enum": ["none", "metadata", "schema"] },
                    "labels": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            },
            "scorecard": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
